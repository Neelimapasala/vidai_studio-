# ===== Required for real AI script/scene generation =====
GROQ_API_KEY=

# ===== Optional providers (leave blank to use built-in fallbacks) =====
IMAGE_API_KEY=
VIDEO_API_KEY=
TTS_API_KEY=
MUSIC_API_KEY=

# ===== App behaviour =====
# true  -> always safe to run (uses sample script/images/offline TTS if real
#          providers are not configured, never crashes the demo)
# false -> require GROQ_API_KEY to be set, no fallback script
USE_DEMO_MODE=true

# Comma separated list of allowed frontend origins for CORS
FRONTEND_URL=http://localhost:5173

# Model used for Groq calls
GROQ_MODEL=llama-3.3-70b-versatile
